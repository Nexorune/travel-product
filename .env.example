# Only server-side variables. Do not use VITE_ for any secret.
MODEL_API_KEY=
MODEL_NAME=
MODEL_BASE_URL=https://api.openai.com/v1
# responses for OpenAI Responses; chat for compatible Chat Completions providers
MODEL_PROTOCOL=chat
AMAP_WEB_KEY=
# Optional web search for source links; without it, uncertain facts remain unknown
TAVILY_API_KEY=
PORT=17887
HOST=127.0.0.1
DATABASE_PATH=data/travel.sqlite
AGENT_MAX_STEPS=12
AGENT_MAX_TOOL_CALLS=32
AGENT_TIMEOUT_MS=180000
AGENT_MAX_OUTPUT_TOKENS=4000
MAX_CONCURRENT_RUNS=2
# Set these on HTTPS deployment, reverse proxy to the API and frontend together
APP_ORIGIN=
COOKIE_SECURE=false
